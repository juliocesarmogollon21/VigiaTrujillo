@model IReadOnlyList<VigiaTrujillo.Models.Usuario>
@{
    ViewData["Title"] = "Administración de Usuarios";

    int total = Model.Count;
    int activos = Model.Count(u => u.Activo);
    int inactivos = total - activos;
    int admins = Model.Count(u => u.Rol == "Administrador" && u.Activo);
    int supervisores = Model.Count(u => u.Rol == "Supervisor" && u.Activo);
    int municipales = Model.Count(u => u.Rol == "PersonalMunicipal" && u.Activo);
    int ciudadanos = Model.Count(u => u.Rol == "Ciudadano" && u.Activo);
}

<div class="vt-page-header">
    <span class="vt-eyebrow">Módulo Administrador</span>
    <h1>Administración de Usuarios</h1>
    <p class="vt-subtitle">Gestione las cuentas, roles y accesos al sistema Vigía Trujillo.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="vt-kpi vt-kpi--accent">
            <div class="vt-kpi__label">Total usuarios</div>
            <div class="vt-kpi__value">@total</div>
            <div class="vt-kpi__meta">Cuentas registradas</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="vt-kpi vt-kpi--success">
            <div class="vt-kpi__label">Activos</div>
            <div class="vt-kpi__value">@activos</div>
            <div class="vt-kpi__meta">Con acceso al sistema</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="vt-kpi vt-kpi--danger">
            <div class="vt-kpi__label">Inactivos</div>
            <div class="vt-kpi__value">@inactivos</div>
            <div class="vt-kpi__meta">Sin poder iniciar sesión</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="vt-kpi vt-kpi--warning">
            <div class="vt-kpi__label">Administradores</div>
            <div class="vt-kpi__value">@admins</div>
            <div class="vt-kpi__meta">Con gestión total</div>
        </div>
    </div>
</div>

@if (admins <= 1)
{
    <div class="alert alert-warning mb-4" role="alert">
        <h6 class="mb-1">
            @(admins == 0 ? "No hay administradores activos" : "Protección del último administrador")
        </h6>
        <p class="mb-0">
            @(admins == 0
                ? "El sistema no tiene administradores activos. Cree uno inmediatamente para garantizar la continuidad operativa."
                : "Solo queda 1 administrador activo. El sistema impide desactivarlo o cambiar su rol para evitar dejar la plataforma sin gestión.")
        </p>
    </div>
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Cuentas del sistema</span>
        <a asp-action="Create" class="btn btn-sm btn-primary">Nuevo usuario</a>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th style="width: 35%;">Usuario</th>
                    <th style="width: 20%;">Rol</th>
                    <th style="width: 15%;" class="text-center">Estado</th>
                    <th style="width: 30%;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4">
                        <div class="vt-empty">
                            <h5 class="vt-empty__title">No hay usuarios registrados</h5>
                            <p class="vt-empty__text">Comience creando el primer usuario del sistema.</p>
                            <a asp-action="Create" class="btn btn-sm btn-primary mt-3">Crear primer usuario</a>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var u in Model)
                {
                    var rolBadgeClass = u.Rol switch
                    {
                        "Administrador" => "vt-badge-danger",
                        "Supervisor" => "vt-badge-info",
                        "PersonalMunicipal" => "vt-badge-success",
                        "Ciudadano" => "vt-badge-neutral",
                        _ => "vt-badge-neutral"
                    };

                    var esUltimoAdmin = u.Rol == "Administrador" && u.Activo && admins == 1;
                    var inicial = u.NombreUsuario.Length > 0 ? u.NombreUsuario[0].ToString().ToUpper() : "?";

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <span class="vt-code d-inline-flex align-items-center justify-content-center"
                                      style="width: 36px; height: 36px; border-radius: 4px; font-weight: 600;">@inicial</span>
                                <div>
                                    <div class="fw-semibold">@u.NombreUsuario</div>
                                    <small class="text-muted">ID: @u.Id</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge @rolBadgeClass">@u.Rol</span>
                        </td>
                        <td class="text-center">
                            @if (u.Activo)
                            {
                                <span class="badge vt-badge-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge vt-badge-neutral">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2 align-items-center">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id" title="Editar usuario">
                                    Editar
                                </a>

                                @if (u.Activo)
                                {
                                    @if (esUltimoAdmin)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                                title="No se puede desactivar al último administrador">
                                            Desactivar
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="Desactivar" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Está seguro de desactivar al usuario @u.NombreUsuario? No podrá iniciar sesión hasta que se reactive.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Desactivar usuario">
                                                Desactivar
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@u.Id" title="Reactivar usuario">
                                        Reactivar
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<p class="text-muted small">
    Mostrando <strong>@total</strong> usuario(s) · @activos activos · @inactivos inactivos
</p>

<div class="card mt-4">
    <div class="card-header">Distribución por rol</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3 col-6">
                <div class="vt-kpi vt-kpi--danger">
                    <div class="vt-kpi__label">Administradores</div>
                    <div class="vt-kpi__value">@admins</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="vt-kpi vt-kpi--accent">
                    <div class="vt-kpi__label">Supervisores</div>
                    <div class="vt-kpi__value">@supervisores</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="vt-kpi vt-kpi--success">
                    <div class="vt-kpi__label">Personal Municipal</div>
                    <div class="vt-kpi__value">@municipales</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="vt-kpi">
                    <div class="vt-kpi__label">Ciudadanos</div>
                    <div class="vt-kpi__value">@ciudadanos</div>
                </div>
            </div>
        </div>
    </div>
</div>
