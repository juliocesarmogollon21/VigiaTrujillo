@{
    ViewData["Title"] = "Incidencia Registrada";
    string codigo = ViewBag.Codigo ?? "INC-000000";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <span class="vt-badge-success">Reporte registrado</span>
                        <h1 class="mt-3 mb-2">Incidencia registrada con éxito</h1>
                        <p class="text-muted mb-0">
                            Tu incidencia ha sido recibida y procesada por el sistema <strong>Vigía Trujillo</strong>.
                        </p>
                    </div>

                    <div class="vt-kpi vt-kpi--success text-center mb-4">
                        <div class="vt-kpi__label">Tu código de seguimiento</div>
                        <div class="vt-figure" style="font-size: 1.75rem; font-weight: 600; letter-spacing: 0.12em; color: var(--vt-primary); margin: 0.25rem 0;">
                            @codigo
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2"
                                onclick="navigator.clipboard.writeText('@codigo'); alert('Código copiado al portapapeles');"
                                title="Copiar código">
                            Copiar código
                        </button>
                    </div>

                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Importante.</strong> Toma una captura de pantalla o anota este código. Es tu
                        <u>único comprobante</u> para consultar el estado de tu reporte en el futuro sin necesidad de
                        iniciar sesión.
                    </div>

                    <hr class="vt-divider" />

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-action="Consultar" class="btn btn-primary px-4">
                            Consultar estado ahora
                        </a>
                        <a asp-controller="Obras" asp-action="Publico" class="btn btn-outline-secondary px-4">
                            Volver al listado de obras
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
