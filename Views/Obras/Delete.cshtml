@model VigiaTrujillo.Models.Obra
@{
    ViewData["Title"] = "Dar de Baja Obra";
    var incidencias = ViewBag.IncidenciasAsociadas as System.Collections.Generic.IReadOnlyList<VigiaTrujillo.Models.Incidencia>
                      ?? new List<VigiaTrujillo.Models.Incidencia>();
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="alert alert-warning mb-4" role="alert">
            <h2 class="h6 fw-bold mb-1">Baja l&oacute;gica de la obra</h2>
            <p class="mb-0">
                La obra <strong>no se eliminar&aacute; de la base de datos</strong>. Se marcar&aacute; como dada de baja y
                dejar&aacute; de mostrarse en los listados y en el portal p&uacute;blico, pero el registro se conservar&aacute;
                &iacute;ntegro, junto con sus incidencias y evidencias, para su auditor&iacute;a.
            </p>
        </div>

        <div class="card">
            <div class="card-header">Confirmar baja</div>
            <div class="card-body">
                <p class="vt-subtitle">Verifique que esta es la obra que desea dar de baja:</p>

                <div class="card mb-4">
                    <div class="card-body">
                        <dl class="vt-dl mb-0">
                            <dt>Nombre de la obra</dt>
                            <dd class="fw-semibold">@Model.Nombre</dd>

                            <dt>C&oacute;digo &Uacute;nico (CUI)</dt>
                            <dd><span class="vt-code">@Model.Cui</span></dd>

                            <dt>Ubicaci&oacute;n</dt>
                            <dd>@Model.Ubicacion</dd>

                            <dt>Estado actual</dt>
                            <dd><span class="badge vt-badge-neutral">@Model.Estado</span></dd>
                        </dl>
                    </div>
                </div>

                @if (incidencias.Count > 0)
                {
                    <div class="alert alert-info">
                        <strong>@incidencias.Count incidencia(s)</strong> est&aacute;n vinculadas a esta obra.
                        Se conservar&aacute;n con la baja, de modo que el historial de reportes ciudadanos
                        permanece disponible para auditor&iacute;a.
                    </div>
                }

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label" for="motivo">
                            Motivo de la baja <span class="text-danger">*</span>
                        </label>
                        <textarea name="motivo" id="motivo" class="form-control" rows="3" required
                                  placeholder="Ej.: Obra cancelada por el contratista, duplicidad con el expediente N&deg; ..."></textarea>
                        <div class="form-text">
                            Este motivo queda registrado en la base de datos junto con la fecha y el usuario responsable.
                        </div>
                    </div>

                    <hr class="vt-divider" />

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1">
                            Cancelar y volver
                        </a>
                        <button type="submit" class="btn btn-warning order-1 order-sm-2">
                            Confirmar baja de la obra
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>