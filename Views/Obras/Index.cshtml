@model VigiaTrujillo.ViewModels.ObraIndexViewModel
@{
    ViewData["Title"] = "Registro de Obras";
    int totalObras = Model.Obras?.Count ?? 0;
    int enEjecucion = Model.Obras?.Count(o => o.Estado == "En ejecución") ?? 0;
    int paralizadas = Model.Obras?.Count(o => o.Estado == "Paralizada") ?? 0;
    int concluidas = Model.Obras?.Count(o => o.Estado == "Concluida") ?? 0;
}

<div class="vt-page-header">
    <span class="vt-eyebrow">Gestión administrativa</span>
    <h1>Registro de Obras Públicas</h1>
    <p class="vt-subtitle">Consulta, gestiona y actualiza la información de los proyectos de inversión.</p>
    <div class="mt-3">
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle me-1"></i>Nueva obra
        </a>
        <a asp-controller="Obras" asp-action="Dashboard" class="btn btn-outline-secondary">Ir al dashboard</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="vt-kpi vt-kpi--accent">
            <div class="vt-kpi__label">Total de obras</div>
            <div class="vt-kpi__value">@totalObras</div>
            <div class="vt-kpi__meta">Registradas en el sistema</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="vt-kpi vt-kpi--success">
            <div class="vt-kpi__label">En ejecución</div>
            <div class="vt-kpi__value">@enEjecucion</div>
            <div class="vt-kpi__meta">Con avance en curso</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="vt-kpi vt-kpi--danger">
            <div class="vt-kpi__label">Paralizadas</div>
            <div class="vt-kpi__value">@paralizadas</div>
            <div class="vt-kpi__meta">Requieren intervención</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="vt-kpi vt-kpi--accent">
            <div class="vt-kpi__label">Concluidas</div>
            <div class="vt-kpi__value">@concluidas</div>
            <div class="vt-kpi__meta">Proyectos finalizados</div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="conSolicitudes" value="@Model.ConSolicitudes" />
            <div class="col-md-5">
                <label class="form-label" for="idxBusqueda">Buscar</label>
                <input type="search" id="idxBusqueda" name="busqueda" value="@Model.Busqueda"
                       class="form-control" placeholder="Buscar por nombre, CUI, ubicación..." />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="idxEstado">Estado</label>
                <select name="estado" id="idxEstado" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="Programada" selected="@(Model.Estado == "Programada")">Programada</option>
                    <option value="En ejecución" selected="@(Model.Estado == "En ejecución")">En ejecución</option>
                    <option value="Concluida" selected="@(Model.Estado == "Concluida")">Concluida</option>
                    <option value="Paralizada" selected="@(Model.Estado == "Paralizada")">Paralizada</option>
                    <option value="Con Sobrecosto" selected="@(Model.Estado == "Con Sobrecosto")">Con Sobrecosto</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || !string.IsNullOrWhiteSpace(Model.Estado) || Model.ConSolicitudes)
                {
                    <a class="btn btn-outline-secondary" asp-action="Index" title="Limpiar filtros">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th style="width: 30%;">Obra</th>
                    <th style="width: 12%;">CUI</th>
                    <th style="width: 15%;">Avance</th>
                    <th style="width: 13%;">Estado</th>
                    <th style="width: 30%;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Obras == null || Model.Obras.Count == 0)
                {
                    <tr>
                        <td colspan="5">
                            <div class="vt-empty">
                                <i class="bi bi-inbox"></i>
                                <p class="vt-empty__title">No se encontraron obras</p>
                                <p class="vt-empty__text">
                                    @(string.IsNullOrWhiteSpace(Model.Busqueda) && string.IsNullOrWhiteSpace(Model.Estado)
                                        ? "Aún no hay obras registradas en el sistema."
                                        : "No hay resultados para los filtros aplicados.")
                                </p>
                                <a asp-action="Create" class="btn btn-primary mt-3">
                                    <i class="bi bi-plus-circle me-1"></i>Registrar primera obra
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Obras)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold mb-1">@item.Nombre</div>
                                <div class="vt-kpi__meta">@item.Ubicacion</div>
                                @if (item.FechaInicio.HasValue || item.FechaFin.HasValue)
                                {
                                    var inicio = item.FechaInicio?.ToString("dd/MM/yyyy") ?? "—";
                                    var fin = item.FechaFin?.ToString("dd/MM/yyyy") ?? "—";
                                    <div class="vt-kpi__meta">@inicio a @fin</div>
                                }
                            </td>
                            <td><span class="vt-code">@item.Cui</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1">
                                        <div class="progress-bar bg-info" role="progressbar"
                                             style="width: @(item.AvanceFisico ?? 0)%"
                                             aria-valuenow="@(item.AvanceFisico ?? 0)" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="vt-figure fw-semibold small" style="min-width: 42px;">
                                        @(item.AvanceFisico?.ToString("N0") ?? "0")%
                                    </span>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(item.Estado == "En ejecución" ? "vt-badge-success" :
                                                     item.Estado == "Concluida" ? "vt-badge-info" :
                                                     item.Estado == "Paralizada" ? "vt-badge-danger" :
                                                     item.Estado == "Con Sobrecosto" ? "vt-badge-warning" :
                                                     item.Estado == "Programada" ? "vt-badge-neutral" : "vt-badge-neutral")">
                                    @(string.IsNullOrWhiteSpace(item.Estado) ? "No especificado" : item.Estado)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                    @if (item.TieneSolicitudPendiente)
                                    {
                                        <button type="button" class="btn btn-sm btn-warning"
                                                data-bs-toggle="modal" data-bs-target="#modalResponderIndex"
                                                data-incidencia-id="@item.IncidenciaIdPendiente"
                                                data-obra-id="@item.Id"
                                                data-codigo="@item.CodigoIncidenciaPendiente"
                                                data-texto-solicitud="@item.TextoSolicitudPendiente"
                                                title="Responder solicitud del supervisor">
                                            <i class="bi bi-chat-left-text"></i>
                                        </button>
                                    }
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-info" asp-action="CambiarEstado" asp-route-id="@item.Id" title="Cambiar estado">
                                        <i class="bi bi-arrow-left-right"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
    <p class="vt-kpi__meta mb-0">
        Mostrando <strong>@totalObras</strong> obra(s)
        @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || !string.IsNullOrWhiteSpace(Model.Estado))
        {
            <span>con los filtros aplicados.</span>
        }
        else
        {
            <span>registradas en el sistema.</span>
        }
    </p>
    <a asp-controller="Obras" asp-action="Dashboard" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-speedometer2 me-1"></i>Ir al dashboard
    </a>
</div>

<!-- ✅ MODAL ACTUALIZADO CON EL TEXTO DE LA SOLICITUD -->
<div class="modal fade" id="modalResponderIndex" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="ResponderSolicitud" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Responder solicitud del Supervisor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="IncidenciaId" id="modalIndexIncidenciaId" />
                    <input type="hidden" name="ObraId" id="modalIndexObraId" />

                    <div class="mb-3">
                        <label class="form-label">Incidencia</label>
                        <div class="form-control-plaintext fw-semibold vt-code" id="modalIndexCodigoIncidencia"></div>
                    </div>

                    <!-- ✅ NUEVO: Bloque para mostrar qué pidió el supervisor -->
                    <div class="alert alert-info border-0 bg-primary bg-opacity-10 mb-3">
                        <h6 class="alert-heading fw-bold text-primary mb-2">
                            <i class="bi bi-chat-left-quote me-1"></i> Solicitud del Supervisor:
                        </h6>
                        <p class="mb-0 small" id="modalTextoSolicitud" style="white-space: pre-wrap;"></p>
                    </div>

                    <div class="mb-3">
                        <label for="respuestaTextoIndex" class="form-label">
                            Tu respuesta oficial <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="respuestaTextoIndex" name="Respuesta" rows="4" required minlength="10"
                                  placeholder="Ejemplo: Se adjunta el acta de entrega de materiales N° 2026-045 emitida por el almacén central..."></textarea>
                        <div class="form-text">Mínimo 10 caracteres. Esta respuesta quedará registrada en el historial.</div>
                    </div>

                    <div class="mb-3">
                        <label for="archivoSustentoIndex" class="form-label">
                            <i class="bi bi-paperclip me-1"></i>Documento de sustento (opcional)
                        </label>
                        <input type="file" class="form-control" id="archivoSustentoIndex" name="ArchivoSustento"
                               accept=".jpg,.jpeg,.png,.pdf,.doc,.docx" />
                        <div class="form-text">Formatos permitidos: JPG, PNG, PDF, DOC. Máximo 10 MB.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-send me-1"></i>Enviar respuesta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modal = document.getElementById('modalResponderIndex');
            if (modal) {
                modal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var incidenciaId = button.getAttribute('data-incidencia-id');
                    var obraId = button.getAttribute('data-obra-id');
                    var codigo = button.getAttribute('data-codigo');
                    var textoSolicitud = button.getAttribute('data-texto-solicitud'); 

                    document.getElementById('modalIndexIncidenciaId').value = incidenciaId;
                    document.getElementById('modalIndexObraId').value = obraId;
                    document.getElementById('modalIndexCodigoIncidencia').textContent = "#" + codigo;
                    document.getElementById('modalTextoSolicitud').textContent = textoSolicitud || "No se encontraron detalles de la solicitud.";
                });
            }
        });
    </script>
}