@inject VigiaTrujillo.Services.Interfaces.IIncidenciaService IncidenciaServiceMenu
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vigía Trujillo</title>
    <script>

        (function () {
            try {
                var t = localStorage.getItem('vt-tema');
                if (!t) {
                    t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { /* almacenamiento no disponible */ }
        })();
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VigiaTrujillo.styles.css" asp-append-version="true" />
</head>
@{

    var sesionIniciada = User.Identity?.IsAuthenticated == true;
    var rutaActual = (Context.Request.Path.Value ?? "/").ToLower().TrimEnd('/');
    var esPantallaAcceso = !sesionIniciada || rutaActual == "/account/login";
    var solicitudesPendientesMenu = 0;
    if (sesionIniciada && (User.IsInRole("PersonalMunicipal") || User.IsInRole("Administrador")))
    {
        try { solicitudesPendientesMenu = IncidenciaServiceMenu.ContarSolicitudesPendientes(); } catch { }
    }
}
<body class="vt-body@(esPantallaAcceso ? " vt-body--solo-acceso" : "")">

<header class="vt-topbar">
        @if (sesionIniciada)
        {
            <button class="vt-topbar__menu d-lg-none" type="button" id="vtSidebarToggle"
                    aria-label="Abrir menu" aria-expanded="false" aria-controls="vtSidebar">
                <i class="bi bi-list"></i>
            </button>
        }

        <a class="vt-brand" asp-controller="Home" asp-action="Index">
            <span class="vt-brand__marco">
                <img src="~/img/escudo-trujillo.png" alt="" class="vt-brand__logo" aria-hidden="true">
            </span>
            <span class="vt-brand__text">
                <span class="vt-brand__title">Vigía Trujillo</span>
                <span class="vt-brand__sub">Municipalidad Distrital de Trujillo</span>
            </span>
        </a>

        <div class="vt-topbar__right">
            <button class="vt-tema-btn" type="button" id="vtTemaBtn"
                    aria-label="Cambiar entre tema claro y oscuro" title="Cambiar tema">
                <i class="bi bi-moon-stars" id="vtTemaIcone" aria-hidden="true"></i>
            </button>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown">
                    <button class="vt-userbtn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="vt-userbtn__avatar" aria-hidden="true">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <span class="vt-userbtn__data">
                            <span class="vt-userbtn__name">@User.Identity.Name</span>
                            <span class="vt-userbtn__role">
                                @{
                                    var rolUsuario = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

                                    var rolLegible = VigiaTrujillo.Models.Usuario.NombreRol(rolUsuario);
                                }
                                @rolLegible
                            </span>
                        </span>
                        <i class="bi bi-chevron-down vt-userbtn__caret" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end border mt-2">
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                @* El ciudadano no tiene cuenta: navega el portal público sin iniciar sesión. *@
                <nav class="vt-topbar__publico d-none d-md-flex" aria-label="Portal ciudadano">
                    <a asp-controller="Obras" asp-action="Publico">Obras públicas</a>
                    <a asp-controller="Incidencias" asp-action="Registrar">Reportar</a>
                    <a asp-controller="Incidencias" asp-action="Consultar">Consultar mi reporte</a>
                </nav>
                <a class="btn btn-sm btn-light fw-medium" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión
                </a>
            }
        </div>
    </header>

    @if (sesionIniciada)
    {

<aside class="vt-sidebar" id="vtSidebar">
        <nav class="vt-sidebar__nav" aria-label="Menu principal">
            <span class="vt-sidebar__group">Consulta pública</span>
            <a class="vt-sideitem" asp-controller="Obras" asp-action="Publico" title="Obras Públicas">
                <i class="bi bi-buildings" aria-hidden="true"></i>
                <span>Obras Públicas</span>
            </a>
            <a class="vt-sideitem" asp-controller="Incidencias" asp-action="Registrar" title="Reportar irregularidad">
                <i class="bi bi-flag" aria-hidden="true"></i>
                <span>Reportar</span>
            </a>
            <a class="vt-sideitem" asp-controller="Incidencias" asp-action="Consultar" title="Consultar mi reporte">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span>Mi Reporte</span>
            </a>

            @if (User.IsInRole("PersonalMunicipal") || User.IsInRole("Administrador"))
            {
                <span class="vt-sidebar__group">Personal Municipal</span>
                <a class="vt-sideitem" asp-controller="Obras" asp-action="Dashboard" title="Dashboard">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    <span>Dashboard</span>
                </a>
                <a class="vt-sideitem" asp-controller="Obras" asp-action="Index" title="Gestion de Obras">
                    <i class="bi bi-kanban" aria-hidden="true"></i>
                    <span>Gestión de Obras</span>
                </a>
                <a class="vt-sideitem" asp-controller="Solicitudes" asp-action="Index" title="Solicitudes del Supervisor">
                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                    <span>Solicitudes</span>
                    @if (solicitudesPendientesMenu > 0)
                    {
                        <span class="badge vt-badge-warning ms-auto">@solicitudesPendientesMenu</span>
                    }
                </a>
                <a class="vt-sideitem" asp-controller="Obras" asp-action="DadosDeBaja" title="Obras dadas de baja">
                    <i class="bi bi-archive" aria-hidden="true"></i>
                    <span>Dadas de Baja</span>
                </a>
            }

            @if (User.IsInRole("Supervisor") || User.IsInRole("Administrador"))
            {
                <span class="vt-sidebar__group">Supervisión</span>
                <a class="vt-sideitem" asp-controller="Supervisor" asp-action="Index" title="Bandeja de incidencias">
                    <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                    <span>Supervisión</span>
                </a>
            }

            @if (User.IsInRole("Administrador"))
            {
                <span class="vt-sidebar__group">Administración</span>
                <a class="vt-sideitem" asp-controller="Usuarios" asp-action="Index" title="Usuarios">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Usuarios</span>
                </a>
            }
        </nav>
    </aside>

    <div class="vt-backdrop" id="vtSidebarBackdrop" hidden></div>
    }

<div class="vt-main">
        <main class="container-fluid py-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                        <span>@TempData["Success"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @RenderBody()
        </main>

        <footer class="vt-footer">
            <div class="container-fluid py-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <p class="text-muted small mb-0">Plataforma de Transparencia y Seguimiento de Obras Públicas.</p>
                        <p class="text-muted small mb-0">Municipalidad Distrital de Trujillo &copy; @DateTime.Now.Year</p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <p class="text-muted small mb-0">Facultad de Ingeniería de Sistemas Computacionales</p>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script>
        (function () {
            var toggle = document.getElementById('vtSidebarToggle');
            var sidebar = document.getElementById('vtSidebar');
            var backdrop = document.getElementById('vtSidebarBackdrop');
            if (!toggle || !sidebar || !backdrop) return;

            function setOpen(open) {
                sidebar.classList.toggle('is-open', open);
                backdrop.hidden = !open;
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            toggle.addEventListener('click', function () {
                setOpen(!sidebar.classList.contains('is-open'));
            });
            backdrop.addEventListener('click', function () { setOpen(false); });
            sidebar.addEventListener('click', function (e) {
                if (e.target.closest('a')) setOpen(false);
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') setOpen(false);
            });
            window.addEventListener('resize', function () {
                if (window.innerWidth >= 992) setOpen(false);
            });

            var path = window.location.pathname.toLowerCase();
            var items = sidebar.querySelectorAll('.vt-sideitem');
            var mejor = null;
            var mejorLargo = 0;
            for (var i = 0; i < items.length; i++) {
                var href = (items[i].getAttribute('href') || '').toLowerCase();
                if (!href || href === '/') continue;
                var coincide = (path === href) || (path.indexOf(href + '/') === 0);
                if (coincide && href.length > mejorLargo) {
                    mejor = items[i];
                    mejorLargo = href.length;
                }
            }
            if (mejor) mejor.classList.add('is-active');
        })();
    </script>

    <script>

        (function () {

            var btnTema = document.getElementById('vtTemaBtn');
            var iconoTema = document.getElementById('vtTemaIcone');

            function pintarIconoTema() {
                var oscuro = document.documentElement.getAttribute('data-theme') === 'dark';
                if (iconoTema) {
                    iconoTema.className = oscuro ? 'bi bi-sun' : 'bi bi-moon-stars';
                }
                if (btnTema) {
                    btnTema.setAttribute('aria-pressed', oscuro ? 'true' : 'false');
                }
            }

            if (btnTema) {
                btnTema.addEventListener('click', function () {
                    var oscuro = document.documentElement.getAttribute('data-theme') === 'dark';
                    var nuevo = oscuro ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', nuevo);
                    try { localStorage.setItem('vt-tema', nuevo); } catch (e) { }
                    pintarIconoTema();
                });
                pintarIconoTema();
            }

        })();
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/vigia-signalr.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>