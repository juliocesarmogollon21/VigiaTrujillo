@model VigiaTrujillo.ViewModels.SupervisorRevisarViewModel
@{
    ViewData["Title"] = "Revisar Incidencia";
    var i = Model.Incidencia;
    var permitidos = (ViewBag.EstadosPermitidos as IReadOnlyList<string>) ?? Array.Empty<string>();
    // "Información solicitada" no se elige en la lista: se pide con el formulario «Solicitar información».
    var estadosDestino = permitidos.Where(e => e != VigiaTrujillo.Models.IncidenciaEstados.InformacionSolicitada).ToList();
    var puedeSolicitarInformacion = permitidos.Contains(VigiaTrujillo.Models.IncidenciaEstados.InformacionSolicitada);
    var esperandoInformacion = VigiaTrujillo.Models.IncidenciaEstados.EsIgual(i.Estado, VigiaTrujillo.Models.IncidenciaEstados.InformacionSolicitada);
    var respuestaRecibida = ViewBag.RespuestaRecibida as bool? == true;
    var cerrada = ViewBag.IncidenciaCerrada as bool? == true;
    var respuestasNuevas = (ViewBag.RespuestasNuevas as List<int>) ?? new List<int>();
    var solicitudes = i.Solicitudes.OrderByDescending(s => s.FechaSolicitud).ToList();
    var observaciones = i.Observaciones.OrderByDescending(o => o.Fecha).ToList();

    var estadoBadge = (VigiaTrujillo.Models.IncidenciaEstados.Canonico(i.Estado) ?? i.Estado) switch
    {
        "Pendiente de revisión" => "vt-badge-warning",
        "En revisión" => "vt-badge-info",
        "Información solicitada" => "vt-badge-neutral",
        "En verificación" => "vt-badge-info",
        "Resuelta" => "vt-badge-success",
        "Derivada" => "vt-badge-danger",
        _ => "vt-badge-neutral"
    };
}

<div class="vt-page-header">
    <span class="vt-eyebrow">Revisión de incidencia</span>
    <h1>Incidencia <span class="vt-code">@i.CodigoSeguimiento</span></h1>
    <p class="vt-subtitle">
        Registrada el @i.FechaRegistro.ToString("dd 'de' MMMM 'de' yyyy 'a las' HH:mm")
        <span class="d-inline-block ms-2">
            <span class="badge @estadoBadge">@i.Estado</span>
            @if (cerrada)
            {
                <span class="badge vt-badge-danger ms-1">Cerrada</span>
            }
        </span>
    </p>
</div>

@if (cerrada)
{
    <div class="alert alert-danger mb-4" role="alert">
        <h5 class="mb-1">Esta incidencia ha sido cerrada</h5>
        <p class="mb-0">No se permiten más cambios de estado ni nuevas observaciones.</p>
        @if (!string.IsNullOrWhiteSpace(i.ResultadoRevision))
        {
            <hr class="vt-divider" />
            <div class="vt-label">Resultado final emitido</div>
            <p class="mb-0" style="white-space: pre-wrap;">@i.ResultadoRevision</p>
        }
    </div>
}

<div class="row g-4">
    <!-- COLUMNA IZQUIERDA: Comparación -->
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header">Comparación de información</div>
            <div class="card-body">
                <p class="vt-subtitle mb-3">Contraste entre los datos oficiales de la obra y la evidencia ciudadana.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header vt-badge-info">Información oficial</div>
                            <div class="card-body">
                                @if (i.Obra != null)
                                {
                                    <dl class="vt-dl">
                                        <dt>Nombre de la obra</dt>
                                        <dd>@i.Obra.Nombre</dd>
                                        <dt>CUI</dt>
                                        <dd><span class="vt-code">@i.Obra.Cui</span></dd>
                                        <dt>Ubicación</dt>
                                        <dd>@i.Obra.Ubicacion</dd>
                                        <dt>Estado actual</dt>
                                        <dd><span class="badge vt-badge-neutral">@i.Obra.Estado</span></dd>
                                        <dt>Avance físico oficial</dt>
                                        <dd class="vt-figure fw-semibold">@((i.Obra.AvanceFisico ?? 0).ToString("0.##"))%</dd>
                                        <dt>Presupuesto</dt>
                                        <dd class="vt-figure">S/ @((i.Obra.Presupuesto ?? 0).ToString("N2"))</dd>
                                        <dt>Contratista</dt>
                                        <dd>@(i.Obra.Contratista ?? "—")</dd>
                                        <dt>Archivos de la obra</dt>
                                        <dd class="mb-0"><span class="badge vt-badge-info">@Model.ArchivosObra.Count archivo(s)</span></dd>
                                    </dl>

                                    @if (Model.ArchivosObra.Any())
                                    {
                                        <div class="row g-2 mt-2">
                                            @foreach (var a in Model.ArchivosObra)
                                            {
                                                var esImagenObra = a.Tipo == "foto" || new[] { ".jpg", ".jpeg", ".png" }.Contains(System.IO.Path.GetExtension(a.Ruta).ToLowerInvariant());
                                                <div class="col-6">
                                                    <div class="vt-evidence">
                                                        @if (esImagenObra)
                                                        {
                                                            <a href="@a.Ruta" target="_blank" rel="noopener">
                                                                <img src="@a.Ruta" alt="@a.Nombre" loading="lazy" />
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="@a.Ruta" target="_blank" rel="noopener" class="d-flex flex-column align-items-center justify-content-center h-100 p-2 text-decoration-none">
                                                                <span class="badge vt-badge-danger">Documento</span>
                                                                <small class="text-truncate w-100 text-center mt-2">@a.Nombre</small>
                                                            </a>
                                                        }
                                                    </div>
                                                    <small class="text-truncate d-block mt-1" title="@a.Nombre">@a.Nombre</small>
                                                    <small class="text-muted d-block vt-figure">@a.FechaCarga.ToString("dd/MM/yyyy")</small>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mt-2 mb-0">El Personal Municipal todavía no ha subido fotos ni documentos de esta obra.</p>
                                    }
                                }
                                else
                                {
                                    <div class="vt-empty">
                                        <h6 class="vt-empty__title">Sin datos de obra</h6>
                                        <p class="vt-empty__text">La incidencia no está asociada a una obra registrada.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header vt-badge-warning">Reporte ciudadano</div>
                            <div class="card-body">
                                <dl class="vt-dl">
                                    <dt>Descripción</dt>
                                    <dd style="white-space: pre-wrap;">@i.Descripcion</dd>
                                    <dt>Evidencias</dt>
                                    <dd><span class="badge vt-badge-warning">@i.Evidencias.Count archivo(s)</span></dd>
                                    <dt>Fecha del reporte</dt>
                                    <dd class="vt-figure mb-0">@i.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4" id="solicitudes-informacion">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Solicitudes de información al Personal Municipal</span>
                <span class="badge vt-badge-neutral">@solicitudes.Count</span>
            </div>
            <div class="card-body">
                @if (!solicitudes.Any())
                {
                    <div class="vt-empty">
                        <h6 class="vt-empty__title">Sin solicitudes</h6>
                        <p class="vt-empty__text">Para pedir información use el formulario «Solicitar información al Personal Municipal».</p>
                    </div>
                }
                else
                {
                    foreach (var sol in solicitudes)
                    {
                        var esNueva = respuestasNuevas.Contains(sol.Id);
                        var badgeSol = sol.Estado switch
                        {
                            VigiaTrujillo.Models.SolicitudInformacion.EstadoRespondida => "vt-badge-success",
                            VigiaTrujillo.Models.SolicitudInformacion.EstadoPendiente => "vt-badge-warning",
                            _ => "vt-badge-neutral"
                        };
                        <div class="border rounded p-3 mb-3 @(esNueva ? "border-success" : "")">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                <div>
                                    <span class="badge @badgeSol">@sol.Estado</span>
                                    @if (esNueva)
                                    {
                                        <span class="badge vt-badge-success ms-1">Respuesta nueva</span>
                                    }
                                </div>
                                <small class="text-muted vt-figure">Solicitado por @sol.SolicitadoPor el @sol.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <div class="vt-label">Pregunta del supervisor</div>
                            <p class="mb-2" style="white-space: pre-wrap;">@sol.Pregunta</p>

                            @if (sol.Estado == VigiaTrujillo.Models.SolicitudInformacion.EstadoRespondida)
                            {
                                <div class="p-3 rounded" style="background-color: rgba(25,135,84,.08);">
                                    <div class="d-flex justify-content-between flex-wrap gap-2 mb-1">
                                        <span class="vt-label mb-0">Respuesta del Personal Municipal</span>
                                        <small class="text-muted vt-figure">@sol.RespondidoPor · @sol.FechaRespuesta?.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-0" style="white-space: pre-wrap;">@sol.Respuesta</p>
                                    @if (!string.IsNullOrWhiteSpace(sol.ArchivoRuta))
                                    {
                                        <a href="@sol.ArchivoRuta" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary mt-2">
                                            <i class="bi bi-paperclip me-1"></i>Ver sustento: @sol.ArchivoNombre
                                        </a>
                                    }
                                </div>
                            }
                            else if (sol.Estado == VigiaTrujillo.Models.SolicitudInformacion.EstadoPendiente)
                            {
                                <p class="text-muted small mb-0">Esperando la respuesta del Personal Municipal.</p>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">La incidencia cambió de estado antes de recibir respuesta.</p>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">Historial de la incidencia · @observaciones.Count registro(s)</div>
            <div class="card-body">
                @if (!observaciones.Any())
                {
                    <p class="text-muted small mb-0">Todavía no hay movimientos registrados.</p>
                }
                else
                {
                    <ul class="vt-timeline mb-0">
                        @foreach (var o in observaciones)
                        {
                            var partesObs = o.Texto.Split(new[] { "\n\n\U0001F4CE Archivo adjunto: " }, StringSplitOptions.None);
                            <li class="vt-timeline__item">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <span class="badge vt-badge-info">@o.Autor</span>
                                    <small class="text-muted vt-figure">@o.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <p class="mb-0 small" style="white-space: pre-wrap;">@partesObs[0]</p>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        
        <div class="card mb-4">
            <div class="card-header">Evidencias del ciudadano</div>
            <div class="card-body">
                @if (i.Evidencias.Any())
                {
                    <div class="row g-3">
                        @foreach (var ev in i.Evidencias)
                        {
                            var esImagen = ev.RutaArchivo.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                                           ev.RutaArchivo.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                                           ev.RutaArchivo.EndsWith(".png", StringComparison.OrdinalIgnoreCase);
                            <div class="col-6 col-md-4">
                                <div class="vt-evidence">
                                    @if (esImagen)
                                    {
                                        <a href="@ev.RutaArchivo" target="_blank">
                                            <img src="@ev.RutaArchivo" alt="@ev.NombreArchivo" loading="lazy" />
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@ev.RutaArchivo" target="_blank" class="d-flex flex-column align-items-center justify-content-center h-100 p-2 text-decoration-none">
                                            <span class="badge vt-badge-danger">Documento</span>
                                            <small class="text-truncate w-100 text-center mt-2">@ev.NombreArchivo</small>
                                        </a>
                                    }
                                </div>
                                <div class="mt-1">
                                    <small class="text-truncate d-block" title="@ev.NombreArchivo">@ev.NombreArchivo</small>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="vt-empty">
                        <h6 class="vt-empty__title">Sin evidencias adjuntas</h6>
                        <p class="vt-empty__text">El ciudadano no adjuntó archivos a este reporte.</p>
                    </div>
                }
            </div>
        </div>

        @if (!cerrada)
        {
            <div class="card mb-4">
                <div class="card-header">Gestión de estado y acciones</div>
                <div class="card-body">
                    <p class="vt-subtitle mb-3">Seleccione el siguiente paso. El flujo solo avanza: Pendiente de revisión → En revisión → Información solicitada → En verificación → Resuelta o Derivada. Solo el supervisor cambia el estado y su decisión queda en el historial.</p>

                    @if (esperandoInformacion && respuestaRecibida)
                    {
                        <div class="alert alert-success small mb-3">
                            El Personal Municipal ya respondió la solicitud. Revise la respuesta y pase la incidencia a «En verificación» para verificarla.
                        </div>
                    }
                    else if (esperandoInformacion)
                    {
                        <div class="alert alert-info small mb-3">
                            Se está esperando la respuesta del Personal Municipal. Cuando responda podrá pasar la incidencia a «En verificación».
                        </div>
                    }

                    <form asp-action="CambiarEstado" method="post" id="formCambiarEstado">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@i.Id" />

                        <label class="form-label" for="selectNuevoEstado">
                            Acción a realizar <span class="text-danger">*</span>
                        </label>
                        <select name="nuevoEstado" id="selectNuevoEstado" class="form-select mb-3" required onchange="ajustarFormularioCierre()">
                            <option value="" disabled selected>— Seleccione una acción —</option>
                            @foreach (var e in estadosDestino)
                            {
                                <option value="@e" data-es-final="@(e == "Resuelta" || e == "Derivada" ? "true" : "false")">@e</option>
                            }
                        </select>

                        @if (!estadosDestino.Any())
                        {
                            <div class="alert alert-warning mb-2">
                                No hay cambios de estado disponibles desde el estado actual.
                            </div>
                        }

                        <label class="form-label" id="labelResultado">Motivo / Sustento (opcional)</label>
                        <textarea name="resultadoRevision" id="textoResultado" class="form-control mb-3" rows="3"
                                  placeholder="Comentarios sobre la acción a realizar..."></textarea>

                        <button type="submit" class="btn btn-primary w-100" id="btnAplicarEstado" @(estadosDestino.Any() ? null : "disabled")>
                            Ejecutar acción
                        </button>
                    </form>
                </div>
            </div>

            @if (puedeSolicitarInformacion)
            {
                <div class="card mb-4">
                    <div class="card-header">Solicitar información al Personal Municipal</div>
                    <div class="card-body">
                        <p class="vt-subtitle mb-3">Si la información recibida no es suficiente, puede pedir más datos las veces que sea necesario. La incidencia pasará a «Información solicitada»; cuando el Personal Municipal responda, usted decide si la pasa a «En verificación».</p>
                        <form asp-action="SolicitarInformacion" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@i.Id" />
                            <label class="form-label" for="notaSolicitud">Información que necesita <span class="text-danger">*</span></label>
                            <textarea name="nota" id="notaSolicitud" class="form-control mb-3" rows="3" required minlength="10" maxlength="1000"
                                      placeholder="Indique qué documento o dato necesita del Personal Municipal..."></textarea>
                            <button type="submit" class="btn btn-warning w-100">Solicitar información</button>
                        </form>
                    </div>
                </div>
            }
        }

        <a asp-action="Index" class="btn btn-outline-secondary w-100">Volver a bandeja de incidencias</a>
    </div>
</div>

@section Scripts {
<script>
    function ajustarFormularioCierre() {
        const select = document.getElementById('selectNuevoEstado');
        const optionSeleccionada = select.options[select.selectedIndex];
        const label = document.getElementById('labelResultado');
        const textarea = document.getElementById('textoResultado');
        const btn = document.getElementById('btnAplicarEstado');

        if (!optionSeleccionada || optionSeleccionada.value === "") {
            label.innerHTML = "Motivo / Sustento (opcional)";
            textarea.required = false;
            textarea.placeholder = "Comentarios sobre la acción a realizar...";
            btn.textContent = "Ejecutar acción";
            btn.className = "btn btn-primary w-100";
            return;
        }

        const estado = optionSeleccionada.value;

        if (estado === "Resuelta" || estado === "Derivada") {
            label.innerHTML = "Sustento documental del resultado final <span class='text-danger'>*</span>";
            textarea.required = true;
            textarea.placeholder = "Detalle el resultado de su análisis y conclusiones finales...";
            btn.textContent = "Emitir resultado y cerrar incidencia";
            btn.className = "btn btn-danger w-100";
        }
        else {
            label.innerHTML = "Motivo / Sustento (opcional)";
            textarea.required = false;
            textarea.placeholder = "Comentarios sobre la acción a realizar...";
            btn.textContent = "Ejecutar acción";
            btn.className = "btn btn-primary w-100";
        }
    }
</script>
}